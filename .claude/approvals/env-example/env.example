# Omnia Recon environment. Copy to .env and fill in. Placeholders only; never commit real values.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Local docker compose database (synthetic data only)
DATABASE_URL=postgres://omnia:omnia_local_dev@localhost:5432/omnia

# HMAC key for NI / bank-account lookup hashes (>= 32 chars). Must stay stable for a database.
HASH_KEY=replace-with-at-least-32-random-characters

# AES-256-GCM key: 32 random bytes, base64
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-32-bytes

# >= 32 chars
SESSION_SECRET=replace-with-at-least-32-random-characters

AUTO_MATCH_THRESHOLD=0.95

# Set to true behind HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false

# Xero (Phase 3). Placeholders until credentials are issued.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3001/api/xero/callback
