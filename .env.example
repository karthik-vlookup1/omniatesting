# Copy to .env and fill in. Never commit .env. Values below are placeholders only.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Docker Postgres from docker-compose.yml. A Windows PostgreSQL service may own 5432; use 5433.
OMNIA_DB_PORT=5433
DATABASE_URL=postgres://omnia:omnia_local_dev@localhost:5433/omnia

# Keys: generate fresh ones, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
HASH_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-bytes-base64
SESSION_SECRET=replace-with-at-least-32-random-characters

# Veco tenancy sync (recon-102). The URL is the Veco read-only SQL MCP endpoint *including* its
# key. Treat it as a secret. Leave empty to disable the sync.
VECO_MCP_URL=
# Local hour (0-23) for the nightly sync; the warehouse refreshes around 03:30.
VECO_SYNC_HOUR=4
