{
  "name": "omnia-recon-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Omnia Recon web frontend: rent reconciliation UI for Omnia Housing.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
